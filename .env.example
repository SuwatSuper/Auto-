# ── KINGDOM PRIME — local configuration ───────────────────────────
# DASHBOARD_API_KEY = token ที่ใช้ล็อก control endpoints (POST /api/*).
# endpoint อันตราย (live switch / credentials / order / close / kill-switch)
# ต้องใช้ token นี้ "เสมอ" แม้บนเครื่องตัวเอง (D3 = strict). ส่งเป็น header X-API-Key.
# ⚠ เก็บไฟล์นี้เป็นความลับ — อย่า commit ขึ้น git (.gitignore กันไว้แล้ว)
DASHBOARD_API_KEY=put-your-secret-key-here
# DASHBOARD_PASSWORD = รหัสผ่าน operator; POST /api/login แลกเป็น token ด้านบน.
# จำเป็นถ้าจะ bind WEB_HOST=0.0.0.0 (เข้าจากมือถือ/LAN) ไม่งั้นระบบ refuse to start.
DASHBOARD_PASSWORD=

# ทุนเริ่มต้น paper trading (THB) — ฐานคำนวณขนาดไม้ + โชว์ใน /api/status (mandate=1000)
INITIAL_CAPITAL=1000
# เป้ากำไรสุทธิต่อวัน (%) — ถึงเป้าแล้วล็อกกำไร หยุดเปิดไม้ใหม่ของวัน (Phase 3)
TARGET_DAILY_PROFIT_PCT=5

# WEB_HOST=0.0.0.0 เพื่อเข้าจากเครื่องอื่น — ต้องตั้ง DASHBOARD_PASSWORD/API_KEY ก่อน
WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_LEVEL=INFO

# ── Execution engine (Phase 2) ───────────────────────────────────────
# ⚠ ค่าเริ่มต้น "paper" — ระบบจำลองเท่านั้น ไม่มีการใช้เงินจริง
# เปลี่ยนเป็น "live" เฉพาะเมื่อตั้ง LIVE_TRADING_CONFIRM ด้วย
EXECUTION_ENGINE=paper
# ⚠ ต้องพิมพ์ให้ตรงทุกตัวอักษร — ป้องกันการเปิดเงินจริงโดยไม่ตั้งใจ
LIVE_TRADING_CONFIRM=

# ── Risk limits เพิ่มเติม (Phase 1) ──────────────────────────────────
# % ขาดทุนสูงสุดต่อสัปดาห์ (เทียบกับทุน)
MAX_WEEKLY_LOSS_PCT=10
# % ขาดทุนสูงสุดต่อเดือน (เทียบกับทุน)
MAX_MONTHLY_LOSS_PCT=15
# จำนวน trade ขาดทุนต่อเนื่องสูงสุดก่อน circuit breaker จะเปิด
# (0 = ไม่จำกัด — ค่าเริ่มต้นในโค้ด; 5 = ตัวอย่างที่ปลอดภัยกว่าสำหรับเงินจริง)
MAX_CONSECUTIVE_LOSSES=5
# จำนวน position ที่เปิดพร้อมกันได้สูงสุด
MAX_OPEN_POSITIONS=3

# ── Strategy selection (Phase 3) ──────────────────────────────────────
# รายชื่อกลยุทธ์ที่เปิดใช้งาน คั่นด้วยจุลภาค (trend_following, breakout, range_reversion)
ENABLED_STRATEGIES=trend_following
# ด่านกรองโอกาสชนะ (entry gate): false = เทรดตามสัญญาณทันที (ค่าเริ่มต้น พร้อมเทรด)
# true = เข้าเฉพาะเมื่อสถิติชนะย้อนหลัง ≥ MIN_P_WIN (เทรดน้อยลงแต่คัดจังหวะกว่า)
ENTRY_GATE_ENABLED=false
# สัญญาณเข้าแบบหลายอินดิเคเตอร์ (confluence): true = ตัดสินจาก EMA+เทรนด์+MACD+RSI
# พร้อมกัน (ฉลาดขึ้น ยืนยันหลายเส้น) · false = ใช้ EMA-cross เส้นเดียวแบบเดิม
MULTI_INDICATOR_ENTRY=true

# ── Bitkub API credentials (จำเป็นเมื่อจะใช้โหมด live / อ่าน wallet จริง) ──
# ⚠ สร้างคู่ Key+Secret จากหน้า API Management ของ Bitkub แล้วพิมพ์ใส่ที่นี่เอง
# ⚠ ห้ามแชร์ไฟล์นี้ ห้ามวางคีย์ในแชทหรือส่งให้ใครเด็ดขาด (zip จากระบบจะไม่รวมไฟล์นี้)
BITKUB_API_KEY=
BITKUB_API_SECRET=

# ── Price feed & news (optional — ค่าเริ่มต้นเหมาะกับโปรดักชันอยู่แล้ว) ──
# PRICE_FEED_MODE=rest (แนะนำ — poll REST ticker v3 เสถียร/ผ่าน firewall) หรือ "ws"
PRICE_FEED_MODE=rest
# เปิด/ปิดการอ่านข่าว (RSS ไม่ต้องใช้ API key) ป้อนให้ News Intelligence agent
NEWS_ENABLED=true

# ── Alerts (optional — Telegram bot หรือ generic webhook) ──
# เว้นว่างได้ถ้าไม่ต้องการแจ้งเตือนภายนอก
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
