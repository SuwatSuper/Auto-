# ── KINGDOM PRIME — local configuration ───────────────────────────
# คีย์นี้ใช้ล็อก control endpoints (POST /api/*) ของแดชบอร์ด
# ⚠ เก็บไฟล์นี้เป็นความลับ — อย่า commit ขึ้น git (.gitignore กันไว้แล้ว)
DASHBOARD_API_KEY=put-your-secret-key-here

# ════════════════════════════════════════════════════════════════════
# 🟢 TRAINING MODE — โหมดเทรนเอเจนต์ (เปิดอยู่ตอนนี้)
# ════════════════════════════════════════════════════════════════════
# เปิดอยู่ = ปลดล็อกทุกลิมิต + ทุน 10,000,000 บาท ให้เอเจนต์เทรดฝึกตัวเองได้เต็มที่:
#   • circuit breaker ไม่ตัดอีก (ขาดทุนต่อเนื่องเท่าไหร่ก็เทรดต่อ)
#   • ขีดจำกัดขาดทุนรายวัน = 100% (แทบไม่หยุด)
#   • survival floor = 0% (ไม่ halt)
#   • เกตยิงเฉพาะ 80% = ปิด (ยิงอิสระเพื่อฝึก)
#   • บังคับเป็น paper เสมอ — เงินจริงปลอดภัย 100%
# ⚠ ค่านี้ "เขียนทับ" INITIAL_CAPITAL / MAX_CONSECUTIVE_LOSSES ฯลฯ ด้านล่างทันที
# 👉 เมื่อมั่นใจแล้วและอยากกลับสู่โหมดมีวินัย (เกต 80% + เบรกเกอร์) ให้ตั้งเป็น false
TRAINING_MODE=true
TRAINING_CAPITAL=10000000

# ทุนเริ่มต้น paper trading (THB) — ใช้เมื่อ TRAINING_MODE=false
INITIAL_CAPITAL=1000000

WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_LEVEL=INFO

# ── Execution engine (Phase 2) ───────────────────────────────────────
# ⚠ ค่าเริ่มต้น "paper" — ระบบจำลองเท่านั้น ไม่มีการใช้เงินจริง
# เปลี่ยนเป็น "live" เฉพาะเมื่อตั้ง LIVE_TRADING_CONFIRM ด้วย (และต้องปิด TRAINING_MODE ก่อน)
EXECUTION_ENGINE=paper
# ⚠ ต้องพิมพ์ให้ตรงทุกตัวอักษร — ป้องกันการเปิดเงินจริงโดยไม่ตั้งใจ
LIVE_TRADING_CONFIRM=

# ── Risk limits เพิ่มเติม (Phase 1) — ใช้เมื่อ TRAINING_MODE=false ──────
# % ขาดทุนสูงสุดต่อสัปดาห์ (เทียบกับทุน)
MAX_WEEKLY_LOSS_PCT=10
# % ขาดทุนสูงสุดต่อเดือน (เทียบกับทุน)
MAX_MONTHLY_LOSS_PCT=15
# จำนวน trade ขาดทุนต่อเนื่องสูงสุดก่อน circuit breaker จะเปิด
MAX_CONSECUTIVE_LOSSES=100
# % ขาดทุนสูงสุดต่อวัน (100 = แทบไม่ตัด)
MAX_DAILY_LOSS_PCT=100
# จำนวน position ที่เปิดพร้อมกันได้สูงสุด
MAX_OPEN_POSITIONS=3
# เกตยิงเฉพาะเมื่ออัตราชนะย้อนหลัง ≥ 80% (ใช้เมื่อ TRAINING_MODE=false)
ENTRY_GATE_ENABLED=true
MIN_P_WIN=0.80

# ── Strategy selection (Phase 3) ──────────────────────────────────────
# รายชื่อกลยุทธ์ที่เปิดใช้งาน คั่นด้วยจุลภาค (trend_following, breakout, range_reversion)
ENABLED_STRATEGIES=trend_following

# ── Bitkub API credentials (จำเป็นเมื่อจะใช้โหมด live / อ่าน wallet จริง) ──
# ⚠ สร้างคู่ Key+Secret จากหน้า API Management ของ Bitkub แล้วพิมพ์ใส่ที่นี่เอง
# ⚠ ห้ามแชร์ไฟล์นี้ ห้ามวางคีย์ในแชทหรือส่งให้ใครเด็ดขาด (zip จากระบบจะไม่รวมไฟล์นี้)
BITKUB_API_KEY=
BITKUB_API_SECRET=
